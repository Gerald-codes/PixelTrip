# =============================================================================
# PixelArt Trip Planner — Backend environment example
# =============================================================================
# Copy this file to `.env` and fill in real values locally. NEVER commit `.env`.
# Every value below is a PLACEHOLDER — replace with real credentials only in your
# local, untracked `.env`.
#
# -----------------------------------------------------------------------------
# Ownership boundary (Requirement 13 — Supabase Ownership Boundary)
# -----------------------------------------------------------------------------
# The BACKEND owns all privileged / service-role Supabase access and every
# AI-related data workflow. The service-role key lives ONLY here, on the backend
# / service role. It grants full, RLS-bypassing access to the database and must
# be treated as a high-value secret.
#
# The FRONTEND NEVER holds the Supabase service-role key. The frontend is limited
# to the anon key (public, RLS-guarded). Any data operation that requires
# privileged access or AI processing belongs to this backend boundary, not the
# frontend.
# =============================================================================

# -----------------------------------------------------------------------------
# App / server configuration
# -----------------------------------------------------------------------------
# Runtime environment name (e.g. development, staging, production).
APP_ENV=development

# Host/port the FastAPI server binds to (uvicorn).
HOST=0.0.0.0
PORT=8000

# Log verbosity for the backend (e.g. debug, info, warning, error).
LOG_LEVEL=info

# Frontend origin(s) allowed to call this API (CORS). Comma-separated for more than
# one, e.g. https://aws-pixeltrip.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — PRIVILEGED / SERVICE-ROLE access (backend only)
# -----------------------------------------------------------------------------
# Base URL of your Supabase project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVICE-ROLE KEY — backend/service role ONLY. Grants full, RLS-bypassing
# access. This key must NEVER be shipped to, bundled with, or held by the
# frontend. Keep it out of version control and client-side code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# (Optional) Anon key, if the backend needs the public client for non-privileged
# reads. The anon key is public/RLS-guarded — it is NOT the service key.
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# -----------------------------------------------------------------------------
# AI / orchestration workflows (backend-owned)
# -----------------------------------------------------------------------------
# The backend owns AI-related data workflows. Provider credentials for AI model
# access live here, never on the frontend.
#
# Google Gemini API key: create one at https://aistudio.google.com/apikey
# (free tier needs no payment method). If the agent nodes cannot reach the model
# they fall back to their deterministic behaviour, so a missing key never breaks a run.
AI_PROVIDER_API_KEY=YOUR_AI_PROVIDER_API_KEY_HERE
# Model id; check https://ai.google.dev/gemini-api/docs/models if Google retires it.
LLM_MODEL_NAME=gemini-3.8-flash
# Tried in order if the model above is out of quota or unavailable. Free-tier quotas
# are per model, so each fallback adds its own daily allowance. Leave empty for none.
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=8192
# 0 disables Gemini Flash's hidden "thinking"; use -1 for dynamic on models that need it.
LLM_THINKING_BUDGET=0

# -----------------------------------------------------------------------------
# Travel data tools used by the AI agent (backend only)
# -----------------------------------------------------------------------------
# Flight search providers, tried in order (comma-separated). A provider that is out of
# monthly quota (HTTP 429) or not subscribed (403) is skipped until it resets.
#   booking18_rapidapi   "Booking COM" (booking-com18): round trip and one way; prices
#                        converted with FLIGHT_FX_RATES. Recommended first.
#   booking_rapidapi     "Booking COM" (booking-com15): prices already in FLIGHT_CURRENCY,
#                        but a small monthly quota on the free plan.
#   priceline_rapidapi   "Priceline COM" (priceline-com2): a last resort. Round trips give
#                        the outbound flight and total price, but no return flight times.
#   skyscanner_rapidapi  "Sky Scrapper": free plan 20 req/month.
#   generic              FLIGHT_API_URL returns the agent's {"options": [...]} shape directly
# One flight search uses about 3 requests. FLIGHT_API_KEY is your RapidAPI key; one key
# works for every RapidAPI API your account is subscribed to (each has its own quota).
# Check each API's real monthly quota on its RapidAPI pricing page.
FLIGHT_PROVIDER=booking18_rapidapi,booking_rapidapi,priceline_rapidapi,skyscanner_rapidapi
FLIGHT_API_KEY=YOUR_RAPIDAPI_KEY_HERE
# Leave the URLs empty to use each provider's default host.
FLIGHT_API_URL=
BOOKING_FLIGHT_API_URL=
BOOKING18_FLIGHT_API_URL=
PRICELINE_FLIGHT_API_URL=
# booking-com18 and priceline-com2 answer in their own currency (USD, CAD, ...). These
# rates convert to FLIGHT_CURRENCY: one unit of each currency in FLIGHT_CURRENCY units.
# Approximate; update when they drift. A currency missing here is refused, not guessed.
FLIGHT_FX_RATES=USD:1.28,CAD:0.93,EUR:1.48,GBP:1.72,AUD:0.85
# Result pages per search for paging providers (15 flights each, cheapest first).
FLIGHT_RESULT_PAGES=1
# Prices are requested in this currency; keep it the same as members' budgets.
FLIGHT_CURRENCY=SGD
FLIGHT_MARKET=en-US
FLIGHT_COUNTRY_CODE=SG
# Seconds allowed for one tool call. A Skyscanner search plus its airport lookups
# can take longer than the default 10.
EXTERNAL_TOOL_TIMEOUT_SECONDS=30

PLACES_API_URL=
PLACES_API_KEY=
WEATHER_API_URL=
WEATHER_API_KEY=
